{
  "A1": [
    {
      "$match": {
        "status": {
          "$in": [
            "completed",
            "shipped",
            "delivered"
          ]
        },
        "timestamp": {
          "$gte": "2025-01-01 00:00:00",
          "$lt": "2025-05-01 00:00:00"
        }
      }
    },
    {
      "$unwind": "$items"
    },
    {
      "$addFields": {
        "net_item": {
          "$multiply": [
            "$items.subtotal",
            {
              "$cond": [
                {
                  "$gt": [
                    "$subtotal",
                    0
                  ]
                },
                {
                  "$divide": [
                    "$total",
                    "$subtotal"
                  ]
                },
                1
              ]
            }
          ]
        }
      }
    },
    {
      "$lookup": {
        "from": "products",
        "localField": "items.product_id",
        "foreignField": "_id",
        "pipeline": [
          {
            "$project": {
              "subcategory.profit_margin": 1
            }
          }
        ],
        "as": "p"
      }
    },
    {
      "$unwind": "$p"
    },
    {
      "$group": {
        "_id": {
          "category": "$items.category_id",
          "month": {
            "$dateToString": {
              "format": "%Y-%m",
              "date": "$timestamp"
            }
          }
        },
        "revenue": {
          "$sum": "$net_item"
        },
        "gross_profit": {
          "$sum": {
            "$multiply": [
              "$net_item",
              "$p.subcategory.profit_margin"
            ]
          }
        },
        "units": {
          "$sum": "$items.quantity"
        },
        "orders": {
          "$addToSet": "$_id"
        }
      }
    },
    {
      "$lookup": {
        "from": "categories",
        "localField": "_id.category",
        "foreignField": "_id",
        "pipeline": [
          {
            "$project": {
              "name": 1
            }
          }
        ],
        "as": "c"
      }
    },
    {
      "$project": {
        "_id": 0,
        "category_id": "$_id.category",
        "month": "$_id.month",
        "category_name": {
          "$first": "$c.name"
        },
        "revenue": {
          "$round": [
            "$revenue",
            2
          ]
        },
        "gross_profit": {
          "$round": [
            "$gross_profit",
            2
          ]
        },
        "margin_pct": {
          "$round": [
            {
              "$multiply": [
                {
                  "$divide": [
                    "$gross_profit",
                    "$revenue"
                  ]
                },
                100
              ]
            },
            1
          ]
        },
        "units": 1,
        "orders": {
          "$size": "$orders"
        }
      }
    },
    {
      "$sort": {
        "month": 1,
        "revenue": -1
      }
    }
  ],
  "A2": [
    {
      "$addFields": {
        "orders": {
          "$ifNull": [
            "$purchase_summary.total_orders",
            0
          ]
        },
        "spent": {
          "$ifNull": [
            "$purchase_summary.total_spent",
            0
          ]
        },
        "recency_days": {
          "$cond": [
            {
              "$ifNull": [
                "$purchase_summary.last_purchase",
                false
              ]
            },
            {
              "$dateDiff": {
                "startDate": "$purchase_summary.last_purchase",
                "endDate": "2025-04-16 00:00:00",
                "unit": "day"
              }
            },
            null
          ]
        }
      }
    },
    {
      "$facet": {
        "by_frequency": [
          {
            "$bucket": {
              "groupBy": "$orders",
              "boundaries": [
                0,
                1,
                2,
                4,
                7,
                1000
              ],
              "default": "other",
              "output": {
                "users": {
                  "$sum": 1
                },
                "total_revenue": {
                  "$sum": "$spent"
                },
                "avg_spent": {
                  "$avg": "$spent"
                },
                "avg_recency_days": {
                  "$avg": "$recency_days"
                }
              }
            }
          },
          {
            "$addFields": {
              "segment": {
                "$switch": {
                  "branches": [
                    {
                      "case": {
                        "$eq": [
                          "$_id",
                          0
                        ]
                      },
                      "then": "0 - Never purchased"
                    },
                    {
                      "case": {
                        "$eq": [
                          "$_id",
                          1
                        ]
                      },
                      "then": "1 - One-time"
                    },
                    {
                      "case": {
                        "$eq": [
                          "$_id",
                          2
                        ]
                      },
                      "then": "2 - Occasional (2-3)"
                    },
                    {
                      "case": {
                        "$eq": [
                          "$_id",
                          4
                        ]
                      },
                      "then": "3 - Regular (4-6)"
                    }
                  ],
                  "default": "4 - Loyal (7+)"
                }
              }
            }
          }
        ],
        "spend_tier_by_state": [
          {
            "$match": {
              "orders": {
                "$gt": 0
              }
            }
          },
          {
            "$group": {
              "_id": "$geo_data.state",
              "buyers": {
                "$sum": 1
              },
              "revenue": {
                "$sum": "$spent"
              }
            }
          },
          {
            "$addFields": {
              "revenue_per_buyer": {
                "$divide": [
                  "$revenue",
                  "$buyers"
                ]
              }
            }
          },
          {
            "$sort": {
              "revenue": -1
            }
          },
          {
            "$limit": 10
          }
        ]
      }
    }
  ],
  "A3": [
    {
      "$match": {
        "status": {
          "$in": [
            "completed",
            "shipped",
            "delivered"
          ]
        }
      }
    },
    {
      "$unwind": "$items"
    },
    {
      "$group": {
        "_id": "$items.product_id",
        "units": {
          "$sum": "$items.quantity"
        },
        "revenue": {
          "$sum": "$items.subtotal"
        },
        "orders": {
          "$sum": 1
        },
        "promo_units": {
          "$sum": {
            "$cond": [
              {
                "$and": [
                  {
                    "$gte": [
                      "$timestamp",
                      "2025-03-02 00:00:00"
                    ]
                  },
                  {
                    "$lt": [
                      "$timestamp",
                      "2025-03-09 00:00:00"
                    ]
                  }
                ]
              },
              "$items.quantity",
              0
            ]
          }
        }
      }
    },
    {
      "$facet": {
        "top_by_units": [
          {
            "$sort": {
              "units": -1
            }
          },
          {
            "$limit": 15
          }
        ],
        "top_by_revenue": [
          {
            "$sort": {
              "revenue": -1
            }
          },
          {
            "$limit": 15
          }
        ],
        "catalog_coverage": [
          {
            "$count": "products_sold"
          }
        ]
      }
    },
    {
      "$project": {
        "top": {
          "$setUnion": [
            "$top_by_units",
            "$top_by_revenue"
          ]
        },
        "top_by_units": "$top_by_units._id",
        "top_by_revenue": "$top_by_revenue._id",
        "catalog_coverage": 1
      }
    },
    {
      "$unwind": "$top"
    },
    {
      "$lookup": {
        "from": "products",
        "localField": "top._id",
        "foreignField": "_id",
        "pipeline": [
          {
            "$project": {
              "name": 1,
              "category.name": 1,
              "base_price": 1
            }
          }
        ],
        "as": "p"
      }
    },
    {
      "$project": {
        "_id": 0,
        "product_id": "$top._id",
        "name": {
          "$first": "$p.name"
        },
        "category": {
          "$first": "$p.category.name"
        },
        "units": "$top.units",
        "revenue": {
          "$round": [
            "$top.revenue",
            2
          ]
        },
        "orders": "$top.orders",
        "promo_week_share_pct": {
          "$round": [
            {
              "$multiply": [
                {
                  "$divide": [
                    "$top.promo_units",
                    "$top.units"
                  ]
                },
                100
              ]
            },
            1
          ]
        },
        "rank_units": {
          "$let": {
            "vars": {
              "i": {
                "$indexOfArray": [
                  "$top_by_units",
                  "$top._id"
                ]
              }
            },
            "in": {
              "$cond": [
                {
                  "$gte": [
                    "$$i",
                    0
                  ]
                },
                {
                  "$add": [
                    "$$i",
                    1
                  ]
                },
                null
              ]
            }
          }
        },
        "rank_revenue": {
          "$let": {
            "vars": {
              "i": {
                "$indexOfArray": [
                  "$top_by_revenue",
                  "$top._id"
                ]
              }
            },
            "in": {
              "$cond": [
                {
                  "$gte": [
                    "$$i",
                    0
                  ]
                },
                {
                  "$add": [
                    "$$i",
                    1
                  ]
                },
                null
              ]
            }
          }
        },
        "products_sold_total": {
          "$first": "$catalog_coverage.products_sold"
        }
      }
    },
    {
      "$sort": {
        "revenue": -1
      }
    }
  ]
}